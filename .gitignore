# Portable embedded Python runtime (Windows binaries + installed packages)
python/

# Virtual environments
venv/
.venv/
env/

# Python bytecode
__pycache__/
*.py[cod]

# Generated by snapshot_v3.py
snapshot.md

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Profiles hold internal IPs and device names; keep them out of version control
# except the sample. Must be "profiles/*" (not "profiles/") for the ! exception to work.
profiles/*
!profiles/sample_profile.json

# Daily event logs (MonitorIT_events_YYYY-MM-DD.csv); contain internal IPs and device names
logs/

# pytest
.pytest_cache/

# Release zips made by tools/build_release.py (share these, don't commit them)
build/

# Throwaway experiments (e.g. the screenshot demo server)
scratch/
